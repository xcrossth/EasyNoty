{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easynoty.app/protocol/v1/schemas/auth.schema.json",
  "title": "EasyNoty Protocol v1 hello and session authentication",
  "$defs": {
    "hello": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "device_name", "supported_protocol_versions", "capabilities"],
      "properties": {
        "role": { "enum": ["android", "windows"] },
        "device_name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "supported_protocol_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
      }
    },
    "challenge": {
      "type": "object", "additionalProperties": false,
      "required": ["challenge_id", "server_nonce", "expires_at_utc"],
      "properties": {
        "challenge_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "server_nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,86}$" },
        "expires_at_utc": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["challenge_id", "key_id", "client_nonce", "proof"],
      "properties": {
        "challenge_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "key_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "client_nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,86}$" },
        "proof": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "success": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "authenticated_at_utc", "expires_at_utc"],
      "properties": {
        "session_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "authenticated_at_utc": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
        "expires_at_utc": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
      }
    }
  }
}
