<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\EasyNoty.ico</ApplicationIcon>
    <RootNamespace>EasyNoty.Desktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EasyNoty.Core/EasyNoty.Core.csproj" />
    <ProjectReference Include="../EasyNoty.Infrastructure/EasyNoty.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\EasyNoty.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
